# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite db
/data

# playwright e2e
/playwright-report/
/test-results/
/e2e/.tmp/

# Dev/build logs
/build*.log
/dev.log
*.log

# python engine bytecode
__pycache__/
*.pyc

# python engine virtualenv (created via `python3.12 -m venv .venv`, see requirements.txt)
/.venv/

# graphify knowledge-graph tool cache (regenerate with `graphify update .`)
/graphify-out/

# Claude Code plugin-installed skill packages (vendored by the plugin manager, not project source)
/.claude/skills/

# one-off local scratch scripts
/.scratch-capture.mjs

# Playwright MCP browser debug session artifacts (console logs, traces)
/.playwright-mcp/

# stray self-referencing symlink (repo root -> repo root); breaks recursive tooling
/universal-asset-analyzer
