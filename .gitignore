# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Anthropic API key file. Lives OUTSIDE the repo by default
# (~/.uaa/anthropic_api_key; see lib/ai/anthropic-key.ts) — this pattern is a
# belt-and-braces guard for a UAA_CONFIG_DIR pointed inside the tree.
anthropic_api_key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite db
/data

# playwright e2e
/playwright-report/
/test-results/
/e2e/.tmp/

# Dev/build logs
/build*.log
/dev.log
*.log

# python engine bytecode
__pycache__/
*.pyc

# python engine virtualenv (created via `python3.12 -m venv .venv`, see requirements.txt)
/.venv/

# graphify knowledge-graph tool cache (regenerate with `graphify update .`)
/graphify-out/

# Claude Code plugin-installed skill packages (vendored by the plugin manager, not project source)
/.claude/skills/

# Claude Code local git worktrees (machine-local checkouts, not project source)
/.claude/worktrees/

# benchmark harness output
/bench-out/

# one-off local scratch scripts
/.scratch-capture.mjs

# Playwright MCP browser debug session artifacts (console logs, traces)
/.playwright-mcp/

# stray self-referencing symlink (repo root -> repo root); breaks recursive tooling
/universal-asset-analyzer

# uaa host toolkit: dev-server pid handle (see scripts/ops/uaa)
/.uaa-dev.pid

# Spotlight/Time Machine exclusion markers dropped into generated dirs by
# `uaa doctor --fix`. Machine-local hygiene, not project source.
.metadata_never_index
.design-refs/
