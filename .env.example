# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# Nothing here is required to start the app — every var has a safe default —
# but AI features need Ollama running locally (see README.md).

# --- AI platform -------------------------------------------------------------
# Model choice is the Router's job (lib/ai/router.ts): it scores the installed
# Ollama models against each task's declared requirements. Do NOT pin a global
# model via OLLAMA_MODEL unless you're intentionally overriding the Router —
# a stale pin here previously forced the weakest installed model on every task
# by default, and survived only because it never matched an installed id
# ("mistral" vs "mistral:latest").

# Which backend runs ANALYSIS tasks (ai-migration/03-architecture.md):
#   ollama (default) — 100% local, today's behavior exactly
#   devin            — Devin cloud sessions for standard/background tasks;
#                      interactive tasks stay on Ollama (guardrail in
#                      lib/ai/analysis-provider.ts) unless pinned below.
AI_PROVIDER=ollama

# Per-task provider pins override the global flag, e.g.:
# AI_TASK_EXPLAIN_MOVEMENT_PROVIDER=devin

# Where Ollama is listening. Default matches a local `ollama serve`.
OLLAMA_HOST=http://localhost:11434

# Optional: pin a specific installed model instead of letting the Router pick.
# OLLAMA_MODEL=mistral:latest

# Optional Router overrides, all handled in lib/ai/config.ts:
# AI_MAX_MODEL_GB=12.75
# AI_DISABLED_MODELS=mistral:latest,qwen3:30b-a3b
# AI_TASK_NL_SCREENER=qwen3:14b

# Set LIVE_AI=1 to run the live-Ollama integration tests (tests/ai-platform-live.test.ts)
# instead of skipping them. Requires Ollama running with models pulled.
# LIVE_AI=1

# --- Third-party data sources --------------------------------------------------
# Free tier at https://app.rentcast.io (50 calls/month) — powers address search
# for Real Estate manual assets. Leave unset to keep that flow manual-only.
# RENTCAST_API_KEY=

# Optional — powers richer news aggregation in lib/news.ts. Get a free key at
# https://newsapi.org. Leave unset to fall back to the free-tier sources.
# NEWSAPI_KEY=

# SEC EDGAR requires a descriptive User-Agent with real contact info per their
# fair-use policy (https://www.sec.gov/os/webmaster-faq#developers). Replace
# with your own app name + email before making heavy EDGAR requests.
# SEC_USER_AGENT="universal-asset-analyzer you@example.com"

# --- Local state ---------------------------------------------------------------
# SQLite DB path. Defaults to data/app.db (gitignored, auto-created on first
# run — no migration step needed).
# DB_PATH=./data/app.db

# --- Screener universe sizes (all optional, sane defaults in lib/) -------------
# SCREENER_UNIVERSE_LIMIT=1000
# SCREENER_SMALLCAP_LIMIT=600
# SCREENER_REIT_LIMIT=300
# SCREENER_ETF_LIMIT=600
# SCREENER_ETF_ENRICH=600
# SCREENER_CRYPTO_LIMIT=250

# --- Error tracking (optional) -------------------------------------------------
# Sentry DSNs — leave unset to disable Sentry entirely (the SDK no-ops without
# a DSN, matching this file's "safe default" rule). Server + client each need
# their own var; both can hold the same DSN value. Dev tooling only — the
# user-facing AI stack stays on local Ollama regardless.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Devin (analysis provider + engineering automation) ------------------------
# Service-user key (`cog_` prefix) and org id (`org-` prefix) from app.devin.ai
# Settings > Service Users (needs ManageOrgSessions; ManageAccountPlaybooks for
# the sync script). Used by lib/ai/providers/devin/* when AI_PROVIDER=devin (or
# a per-task pin), by scripts/devin/*, and by the .github/workflows/devin-*
# automations (in CI these come from GitHub Actions secrets, not this file).
# DEVIN_API_KEY=
# DEVIN_ORG_ID=
# Agent mode for analysis sessions: normal | fast (default; ~2x faster, 4x ACU).
# DEVIN_MODE=fast
# Hard per-session ACU cap for analysis sessions (per-task override in task-registry).
# DEVIN_MAX_ACU=4
# Org playbook carrying the analysis house style — from scripts/devin/sync-devin-assets.mjs.
# DEVIN_PLAYBOOK_ID=

# --- Misc ------------------------------------------------------------------
# Base URL the app uses to call its own API routes server-side (e.g. from
# app/api/portfolio/new-positions/route.ts). Defaults to localhost:3000.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base URL the standalone monitor script (scripts/monitor.mjs) polls.
# UAA_URL=http://localhost:3000

# Poll interval (ms) for the in-process alert monitor scheduler.
# UAA_MONITOR_INTERVAL_MS=300000

# Interval (ms) for the in-process Scanner auto-refresh (keeps the homepage
# Radar off "stale scan" without visiting /scanner). Floors at 5 min — the
# pipeline is a multi-minute local-model run. 0 disables.
# UAA_SCANNER_INTERVAL_MS=3600000

# ── Devin sessions API (Phase 4+ of the AI migration; see ai-migration/) ──────
# Service-user key (cog_...) with ManageOrgSessions + UseDevinSessions.
# Create under Settings > Service users in the Devin web app. NEVER commit real values.
# DEVIN_API_KEY=cog_your_key_here
# DEVIN_ORG_ID=org-your_org_id
# DEVIN_API_BASE=https://api.devin.ai/v3
# DEVIN_API_MODE=normal            # normal | fast (fast: ~2x faster, 4x more expensive)
# DEVIN_API_MAX_ACU=5              # per-session runaway fuse
# DEVIN_API_CONCURRENCY=4          # max simultaneous sessions from the job worker
# DEVIN_PLAYBOOK_ANALYSIS=         # playbook id, filled by scripts/devin-setup.ts (Phase 5)
# AI_PROVIDER=                     # coarse switch: devin | ollama (unset = default chain)
