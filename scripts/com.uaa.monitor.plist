<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: runs the UAA background alert monitor every 5 minutes.
  Edit WorkingDirectory to the absolute path of your checkout, then:
    cp scripts/com.uaa.monitor.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.uaa.monitor.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.uaa.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>scripts/monitor.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/divit/universal-asset-analyzer</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/uaa-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/uaa-monitor.err.log</string>
</dict>
</plist>
